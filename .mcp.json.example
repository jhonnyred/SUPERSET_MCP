{
  "mcpServers": {
    "superset": {
      "type": "stdio",
      "command": "/caminho/para/venv/bin/python3",
      "args": [
        "/caminho/para/SUPERSET_MCP/mcp_server.py"
      ],
      "env": {
        "SUPERSET_URL": "http://localhost:8088",
        "SUPERSET_USER": "admin",
        "SUPERSET_PASS": "admin"
      }
    }
  }
}
